{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "Provider": "postgresql",
    "AutoMigrate": false,
    "SeedDemoData": false,
    "ProvisionDemoData": false,
    "RequireExternalMigration": true
  },
  "Cache": {
    "LocalCacheExpirationSeconds": 30
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxRetries": 8,
    "LeaseSeconds": 120,
    "FallbackScanIntervalSeconds": 300
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Jwt": {
    "Authority": "",
    "Issuer": "EnterpriseDistributedCore",
    "Audience": "EnterpriseDistributedCoreClients",
    "RequireHttpsMetadata": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Wolverine": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithProcessName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "WolverineOrderCore",
      "ServiceVersion": "1.0.0"
    }
  },
  "AllowedHosts": "*"
}
