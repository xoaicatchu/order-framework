@baseUrl = http://localhost:5000
@contentType = application/json

###############################################################################
# 1. AUTHENTICATION & DYNAMIC RBAC (IAM & ROOT USER)
###############################################################################

### 1.1 Đăng nhập Root User (System Admin tối cao - Toàn quyền toàn hệ thống)
# @name loginRoot
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "root_superadmin",
  "isRoot": true
}

### Lưu Token của Root Admin
@rootToken = {{loginRoot.response.body.data.accessToken}}


### 1.2 Đăng nhập Admin Đơn Vị (alice_manager - default-tenant)
# @name loginAdminDonVi
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "alice_manager",
  "tenantId": "default-tenant"
}

### Lưu Token của Admin Đơn Vị
@adminToken = {{loginAdminDonVi.response.body.data.accessToken}}


### 1.3 Đăng nhập Nhân viên vận hành (bob_operator - Chưa có quyền Cancel)
# @name loginOperator
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "bob_operator",
  "tenantId": "default-tenant"
}

### Lưu Token của Operator
@operatorToken = {{loginOperator.response.body.data.accessToken}}


### 1.4 Đăng nhập Quản trị viên Đơn vị B (charlie_tenant_b)
# @name loginTenantB
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "charlie_tenant_b",
  "tenantId": "tenant-b"
}

### Lưu Token của Tenant B
@tenantBToken = {{loginTenantB.response.body.data.accessToken}}


### 1.5 Kiểm tra thông tin tài khoản hiện tại từ Token (/api/auth/me)
# @name getCurrentUser
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{adminToken}}


###############################################################################
# 2. SMART MATRIX & UI PERMISSION MANAGEMENT (DÀNH CHO UI ĐƠN VỊ TÙY BIẾN)
###############################################################################

### 2.1 [UI] Lấy cấu trúc Smart Matrix để Frontend vẽ bảng Ma trận phân quyền (Có ô Checkbox và ô Gạch ngang)
# @name getPermissionsMatrix
GET {{baseUrl}}/api/roles/permissions/matrix


### 2.2 Lấy danh mục tất cả quyền hạn có sẵn trong hệ thống
# @name getAllPermissions
GET {{baseUrl}}/api/roles/permissions
Authorization: Bearer {{adminToken}}


### 2.3 Lấy danh sách các vai trò động của đơn vị hiện tại
# @name getTenantRoles
GET {{baseUrl}}/api/roles
Authorization: Bearer {{adminToken}}


### 2.4 [Admin Đơn vị] Tự tạo vai trò động mới trên UI: "SalesAssociate" (Chỉ cho phép Xem và Lập đơn)
# @name createCustomRole
POST {{baseUrl}}/api/roles
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "SalesAssociate",
  "description": "Sales associate role with clean English permission keys",
  "permissions": [
    "Orders:Read",
    "Orders:Create"
  ]
}

### Lưu ID vai trò động vừa tạo
@customRoleId = {{createCustomRole.response.body.data.id}}


### 2.5 [Admin Đơn vị] Gán vai trò "SalesAssociate" cho nhân sự mới "david_sales"
# @name assignUserRole
POST {{baseUrl}}/api/roles/assign
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "userId": "david_sales",
  "roleIds": [
    "{{customRoleId}}"
  ]
}


### 2.6 Nhân sự "david_sales" đăng nhập vào đơn vị (Nhận quyền động từ DB)
# @name loginDavid
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "david_sales",
  "tenantId": "default-tenant"
}

### Lưu Token của David
@davidToken = {{loginDavid.response.body.data.accessToken}}


###############################################################################
# 3. KIỂM TRA PHÂN QUYỀN ĐỘNG & BẢO MẬT API
###############################################################################

### 3.1 David tạo đơn hàng mới với Idempotency-Key (HỢP LỆ vì có Orders:Create)
# @name davidCreateOrder
POST {{baseUrl}}/api/orders/create
Authorization: Bearer {{davidToken}}
Idempotency-Key: david-idem-002
Content-Type: {{contentType}}

{
  "customerName": "Clean i18n Enterprise Client",
  "customerEmail": "contact@clean-i18n.vn",
  "items": [
    {
      "productName": "Enterprise Distributed Suite",
      "sku": "SKU-DIST-01",
      "quantity": 1,
      "unitPrice": 1200.00
    }
  ]
}

### Lưu Order ID do David tạo
@davidOrderId = {{davidCreateOrder.response.body.data.id}}


### 3.2 David thử gửi lệnh HỦY ĐƠN HÀNG -> Kết quả: 403 Forbidden (Do SalesAssociate không có Orders:Cancel)
# @name davidCancelBlocked
DELETE {{baseUrl}}/api/orders/{{davidOrderId}}/cancel
Authorization: Bearer {{davidToken}}


### 3.3 [Admin Đơn vị] Nâng cấp quyền: Tùy biến sửa vai trò "SalesAssociate" BỔ SUNG thêm quyền "Orders:Cancel"
# @name updateRoleGrantCancel
PUT {{baseUrl}}/api/roles/{{customRoleId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "SalesAssociate",
  "description": "Sales associate role upgraded with cancel permission",
  "permissions": [
    "Orders:Read",
    "Orders:Create",
    "Orders:Cancel"
  ]
}


### 3.4 David thực hiện HỦY ĐƠN HÀNG (Bước 1: Prompt xác nhận) -> Thành công ngay lập tức không cần đăng nhập lại!
# @name davidCancelStep1
DELETE {{baseUrl}}/api/orders/{{davidOrderId}}/cancel
Authorization: Bearer {{davidToken}}


### 3.5 David xác nhận HỦY ĐƠN HÀNG (Bước 2: isConfirmed = true) -> Thành công hủy đơn!
# @name davidCancelStep2
DELETE {{baseUrl}}/api/orders/{{davidOrderId}}/cancel?isConfirmed=true
Authorization: Bearer {{davidToken}}


###############################################################################
# 4. MULTI-TENANCY DATA ISOLATION & AUDIT LOGS
###############################################################################

### 4.1 Tenant B truy cập đơn hàng của Tenant Default -> Kết quả: 404 Not Found (Cách ly dữ liệu 100%)
# @name tenantBGetOtherTenantOrder
GET {{baseUrl}}/api/orders/{{davidOrderId}}
Authorization: Bearer {{tenantBToken}}


### 4.2 Lấy danh sách Audit Logs (Yêu cầu quyền AuditLogs:Read)
# @name getAuditLogs
GET {{baseUrl}}/api/auditlogs/list?pageIndex=1&pageSize=10
Authorization: Bearer {{adminToken}}


### 4.3 Xem thống kê tổng hợp đơn hàng (Yêu cầu quyền Orders:Read)
# @name getStatistics
GET {{baseUrl}}/api/orders/statistics/summary
Authorization: Bearer {{adminToken}}


###############################################################################
# 5. TEMPLATE-DRIVEN REPORTING & DOCUMENT RENDERING ENGINE
###############################################################################

### 5.1 Lấy danh mục các mẫu in (Templates) có sẵn của đơn vị
# @name getTemplates
GET {{baseUrl}}/api/reports/templates
Authorization: Bearer {{adminToken}}


### 5.2 In Hóa đơn đơn hàng ra định dạng PDF vector chuẩn in ấn A4 (QuestPDF Engine)
# @name printOrderPdf
GET {{baseUrl}}/api/reports/orders/{{davidOrderId}}/print?format=Pdf
Authorization: Bearer {{adminToken}}


### 5.3 Xem trước bản in Hóa đơn trên Web (HTML Preview với QR Code & Tiền bằng chữ)
# @name printOrderHtml
GET {{baseUrl}}/api/reports/orders/{{davidOrderId}}/print?format=Html
Authorization: Bearer {{adminToken}}


### 5.4 Render báo cáo theo Payload động bất kỳ ra file PDF (POST /api/reports/render)
# @name renderCustomReport
POST {{baseUrl}}/api/reports/render
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "templateCode": "Invoice_A4",
  "dataModel": {
    "OrderNumber": "ORD-DOC-8888",
    "TenantId": "Enterprise-Hospital",
    "CustomerName": "Bệnh Viện Đa Khoa Quốc Tế",
    "CustomerEmail": "contact@bvquocte.vn",
    "Status": "Completed",
    "CreatedAt": "2026-08-20T10:00:00Z",
    "CreatedBy": "Bác sĩ trưởng khoa",
    "TotalAmount": 55000.0,
    "Items": [
      {
        "ProductName": "Hệ thống Phân tích Xét nghiệm Tự động",
        "Sku": "MED-AUTO-01",
        "Quantity": 1,
        "UnitPrice": 45000.0,
        "Total": 45000.0
      },
      {
        "ProductName": "Bộ Hóa chất Xét nghiệm Sinh hóa",
        "Sku": "MED-CHEM-02",
        "Quantity": 10,
        "UnitPrice": 1000.0,
        "Total": 10000.0
      }
    ]
  },
  "format": 0
}
