{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=orders.db",
    "Redis": ""
  },
  "Database": {
    "SchemaManagement": "migrate"
  },
  "Cache": {
    "LocalCacheExpirationSeconds": 30
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Jwt": {
    "Authority": "",
    "Issuer": "EnterpriseDistributedCore",
    "Audience": "EnterpriseDistributedCoreClients",
    "RequireHttpsMetadata": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Wolverine": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithProcessName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "WolverineOrderCore",
      "ServiceVersion": "1.0.0"
    }
  },
  "AllowedHosts": "*"
}
