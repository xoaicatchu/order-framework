@baseUrl = http://localhost:5000
@contentType = application/json

###############################################################################
# 1. AUTHENTICATION & JWT TOKEN GENERATION (IAM)
###############################################################################

### 1.1 Đăng nhập lấy Token cho Quản Lý (Manager / Admin - Default Tenant)
# @name loginManager
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "alice_manager",
  "role": "Manager",
  "tenantId": "default-tenant"
}

### Lưu Token của Manager
@managerToken = {{loginManager.response.body.data.accessToken}}


### 1.2 Đăng nhập lấy Token cho Nhân viên vận hành (Operator - Không có quyền Cancel)
# @name loginOperator
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "bob_operator",
  "role": "Operator",
  "tenantId": "default-tenant"
}

### Lưu Token của Operator
@operatorToken = {{loginOperator.response.body.data.accessToken}}


### 1.3 Đăng nhập lấy Token cho Quản trị viên Tenant B (charlie_tenant_b)
# @name loginTenantB
POST {{baseUrl}}/api/auth/token
Content-Type: {{contentType}}

{
  "username": "charlie_tenant_b",
  "role": "Admin",
  "tenantId": "tenant-b"
}

### Lưu Token của Tenant B
@tenantBToken = {{loginTenantB.response.body.data.accessToken}}


### 1.4 Kiểm tra thông tin tài khoản hiện tại từ Token (/api/auth/me)
# @name getCurrentUser
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{managerToken}}


###############################################################################
# 2. IDEMPOTENCY-KEY & ORDER CREATION (Happy Path)
###############################################################################
### 2.1 Tạo đơn hàng với Header Idempotency-Key (Lần 1 - Thành công 201)
# @name createOrder1
POST {{baseUrl}}/api/orders/create
Authorization: Bearer {{managerToken}}
Content-Type: {{contentType}}
X-Correlation-Id: trace-req-0001
Idempotency-Key: idempotency-uuid-00000001

{
  "customerName": "John Smith",
  "customerEmail": "john.smith@example.com",
  "items": [
    {
      "productName": "Laptop Dell XPS",
      "sku": "SKU-LAP-001",
      "quantity": 1,
      "unitPrice": 999.99
    },
    {
      "productName": "Wireless Mouse",
      "sku": "SKU-MOU-002",
      "quantity": 2,
      "unitPrice": 29.99
    }
  ]
}

### Lưu Order ID 1
@orderId1 = {{createOrder1.response.body.data.id}}


### 2.2 Test Chống Click Đúp: Gửi lại y hệt với cùng Idempotency-Key (Trả về kết quả từ Cache ngay lập tức!)
# @name createOrder1Duplicate
POST {{baseUrl}}/api/orders/create
Authorization: Bearer {{managerToken}}
Content-Type: {{contentType}}
Idempotency-Key: idempotency-uuid-00000001

{
  "customerName": "John Smith",
  "customerEmail": "john.smith@example.com",
  "items": [
    {
      "productName": "Laptop Dell XPS",
      "sku": "SKU-LAP-001",
      "quantity": 1,
      "unitPrice": 999.99
    }
  ]
}


###############################################################################
# 3. VALIDATION FAILURE (Streamlined 400 Bad Request)
###############################################################################
# @name validationFailure
POST {{baseUrl}}/api/orders/create
Authorization: Bearer {{managerToken}}
Content-Type: {{contentType}}

{
  "customerName": "",
  "customerEmail": "invalid-email-format",
  "items": [
    {
      "productName": "",
      "sku": "",
      "quantity": 0,
      "unitPrice": -10.0
    }
  ]
}


###############################################################################
# 4. GET ORDER DETAILS (HybridCache L1/L2 Cache-Aside)
###############################################################################
### Lần 1: Cache Miss (Query Database)
# @name getOrderByIdCacheMiss
GET {{baseUrl}}/api/orders/{{orderId1}}
Authorization: Bearer {{managerToken}}
Accept: {{contentType}}

### Lần 2: Cache HIT (Lấy trực tiếp từ RAM trong 0.01ms!)
# @name getOrderByIdCacheHit
GET {{baseUrl}}/api/orders/{{orderId1}}
Authorization: Bearer {{managerToken}}
Accept: {{contentType}}


###############################################################################
# 5. CREATE ORDER 2 (For Confirmation Flow & RBAC Tests)
###############################################################################
# @name createOrder2
POST {{baseUrl}}/api/orders/create
Authorization: Bearer {{operatorToken}}
Content-Type: {{contentType}}

{
  "customerName": "Jane Doe",
  "customerEmail": "jane.doe@example.com",
  "items": [
    {
      "productName": "Monitor 4K LG",
      "sku": "SKU-MON-003",
      "quantity": 1,
      "unitPrice": 299.99
    }
  ]
}

@orderId2 = {{createOrder2.response.body.data.id}}


###############################################################################
# 6. GET PAGINATED ORDERS (1-Line Mapster Projection Paging)
###############################################################################
# @name listOrders
GET {{baseUrl}}/api/orders/list?pageIndex=1&pageSize=10
Authorization: Bearer {{managerToken}}
Accept: {{contentType}}


###############################################################################
# 7. UPDATE ORDER STATUS (Auto Cache Invalidation via Wolverine AOP)
###############################################################################
# @name updateStatus
PUT {{baseUrl}}/api/orders/{{orderId1}}/status
Authorization: Bearer {{operatorToken}}
Content-Type: {{contentType}}

{
  "status": "Confirmed"
}


###############################################################################
# 8. RBAC PERMISSION CHECK: CANCEL ORDER
###############################################################################
### 8.1 Thử hủy đơn bằng quyền Operator (Sẽ bị chặn 403 Forbidden!)
# @name cancelOrderForbidden
DELETE {{baseUrl}}/api/orders/{{orderId2}}/cancel
Authorization: Bearer {{operatorToken}}

### 8.2 Hủy đơn bằng quyền Manager - Bước 1 (Trả về REQUIRES_CONFIRMATION)
# @name cancelOrderStep1
DELETE {{baseUrl}}/api/orders/{{orderId2}}/cancel
Authorization: Bearer {{managerToken}}

### 8.3 Hủy đơn bằng quyền Manager - Bước 2 (Bấm OK -> isConfirmed=true)
# @name cancelOrderStep2
DELETE {{baseUrl}}/api/orders/{{orderId2}}/cancel?isConfirmed=true
Authorization: Bearer {{managerToken}}


###############################################################################
# 9. GET ORDER STATISTICS (HybridCache 30s TTL)
###############################################################################
# @name getStatistics
GET {{baseUrl}}/api/orders/statistics/summary
Authorization: Bearer {{managerToken}}


###############################################################################
# 10. GET AUDIT LOGS (Chỉ Admin mới có quyền xem)
###############################################################################
# @name getAuditLogs
GET {{baseUrl}}/api/auditlogs/list?pageIndex=1&pageSize=10
Authorization: Bearer {{tenantBToken}}


###############################################################################
# 11. MULTI-TENANCY ISOLATION TEST (Tenant B vs Default Tenant)
###############################################################################
### 11.1 Tạo đơn hàng cho Tenant B (Tự động trích xuất TenantId từ JWT Token)
# @name createTenantBOrder
POST {{baseUrl}}/api/orders/create
Authorization: Bearer {{tenantBToken}}
Content-Type: {{contentType}}

{
  "customerName": "VIP Client (Tenant B)",
  "customerEmail": "vip@tenant-b.com",
  "items": [
    {
      "productName": "Enterprise Server Rack",
      "sku": "SKU-SRV-999",
      "quantity": 1,
      "unitPrice": 4999.00
    }
  ]
}

### 11.2 Query Tenant B: Chỉ thấy đơn hàng của Tenant B
# @name listTenantBOrders
GET {{baseUrl}}/api/orders/list?pageIndex=1&pageSize=10
Authorization: Bearer {{tenantBToken}}

### 11.3 Query Default Tenant: KHÔNG THỂ THẤY đơn hàng của Tenant B
# @name listDefaultTenantOrders
GET {{baseUrl}}/api/orders/list?pageIndex=1&pageSize=10
Authorization: Bearer {{managerToken}}


###############################################################################
# 12. KUBERNETES OBSERVABILITY & HEALTH CHECK PROBES (Public)
###############################################################################
### Kubernetes Liveness Probe
# @name k8sLiveness
GET {{baseUrl}}/health/live

### Kubernetes Readiness Probe
# @name k8sReadiness
GET {{baseUrl}}/health/ready

### Deep System Telemetry & Metrics
# @name deepHealthTelemetry
GET {{baseUrl}}/health
